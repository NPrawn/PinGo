VITE_API_BASE_URL=https://jenkins.example.invalid
VITE_WS_BASE_URL=wss://jenkins.example.invalid
VITE_APP_ENV=production
# Set to false to restore browser/server STT for a real consultation.
VITE_DEMO_CAPTIONS=true

# 배포 백엔드로 붙을 때. VITE_API_BASE_URL을 빈 값으로 두면 앱이 상대 경로로 부르고
# 개발 서버 프록시가 아래 주소로 넘겨준다. 브라우저에는 같은 오리진이라 CORS가 없고,
# 폰에서 LAN 주소로 접속해 확인할 때도 그대로 동작한다.
#   VITE_API_BASE_URL=
#   VITE_DEV_API_TARGET=https://jenkins.example.invalid
VITE_DEV_API_TARGET=https://jenkins.example.invalid
VITE_NAVER_MAP_BASE_URL=
VITE_STUN_URL=
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
